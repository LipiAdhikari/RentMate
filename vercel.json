{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "@vercel/php" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "storage/app/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/storage/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/storage/app/public/$1" },
    { "src": "/(.*)", "dest": "api/index.php" }
  ],
  "outputDirectory": "public",
  "framework": null,
  "regions": ["iad1"]
}
