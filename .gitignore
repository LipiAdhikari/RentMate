# Environment files (exclude all .env variants except safe example)
.env
.env.*
.env*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Build artifacts & public dynamic files
/public/build/
/public/hot
/public/storage

# Storage, logs, and caches
/storage/*.key
/storage/pail
/storage/logs/*
!storage/logs/.gitignore
/bootstrap/cache/*
!bootstrap/cache/.gitignore

# Test & coverage caches
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Temporary and backup files
*.log
*.tmp
*.bak

# OS generated files
.DS_Store
Thumbs.db

# IDEs & Editor configurations
/.idea
.idea/
/.vscode
.vscode/
/.fleet
/.nova
/.zed
/auth.json
.phpactor.json
Homestead.json
Homestead.yaml

# Hosting provider local artifacts
.vercel/
supabase/.temp/
